<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Native social-auth deep link: the backend redirects the OAuth
                 callback to com.flylive.app://callback?code=… (ADR 0011).
                 Android App Links / assetlinks.json is out of scope here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.flylive.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Microphone foreground service (capacitor-03): keeps the shell's
             process (and its WebRTC mic capture) alive while a Speaker/DJ
             produces with the screen off. Holds the process foreground only —
             no audio logic of its own. START_NOT_STICKY + onTaskRemoved stop
             so it never outlives a live producing session. -->
        <service
            android:name=".fgs.MicrophoneForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false"
        />

        <!-- Media-playback foreground service (capacitor-04): keeps the shell's
             process (and its WebRTC playback) alive while a Listener hears a room
             with the screen off. Process-survival only — no audio logic. A seated
             Speaker runs this AND the microphone service at once (union, D1).
             START_NOT_STICKY + onTaskRemoved stop so it never outlives a live
             consuming session. -->
        <service
            android:name=".fgs.MediaPlaybackForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WebRTC getUserMedia (mic) — Capacitor's WebChromeClient grants the
         WebView audio-capture request once RECORD_AUDIO is held at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- DM camera capture (dm-messenger-v2/03): <input capture="environment">
         in the WebView only launches the camera when CAMERA is held; without
         it Capacitor silently falls back to the file picker. Marked not
         required so Play doesn't filter camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Microphone foreground service (capacitor-03). FOREGROUND_SERVICE_MICROPHONE
         + the matching foregroundServiceType are required on Android 14+ (target
         SDK 36). POST_NOTIFICATIONS (API 33+) lets the persistent broadcasting
         notification render — denial does NOT stop the service, only hides the
         notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Media-playback foreground service (capacitor-04). Required on Android 14+
         alongside the matching foregroundServiceType. No runtime permission of its
         own — it keeps a Listener's WebRTC playback alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>
