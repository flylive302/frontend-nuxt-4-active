<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Native social-auth deep link: the backend redirects the OAuth
                 callback to com.flylive.app://callback?code=… (ADR 0011).
                 Android App Links / assetlinks.json is out of scope here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.flylive.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Microphone foreground service (capacitor-03): keeps the shell's
             process (and its WebRTC mic capture) alive while a Speaker/DJ
             produces with the screen off. Holds the process foreground only —
             no audio logic of its own. START_NOT_STICKY + onTaskRemoved stop
             so it never outlives a live producing session. -->
        <service
            android:name=".fgs.MicrophoneForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- WebRTC getUserMedia (mic) — Capacitor's WebChromeClient grants the
         WebView audio-capture request once RECORD_AUDIO is held at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Microphone foreground service (capacitor-03). FOREGROUND_SERVICE_MICROPHONE
         + the matching foregroundServiceType are required on Android 14+ (target
         SDK 36). POST_NOTIFICATIONS (API 33+) lets the persistent broadcasting
         notification render — denial does NOT stop the service, only hides the
         notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
