# Capacitor native build env — copy to `.env.capacitor` and fill with your
# REMOTE (staging/production) URLs before running `npm run cap:build`.
#
# These NUXT_PUBLIC_* values are BAKED INTO THE BUNDLE at `nuxi generate` time.
# A bundled app on a phone cannot reach `localhost` — if any of these still
# point at localhost the app will install but fail to load rooms / connect
# sockets / produce audio.

# Laravel REST API
NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
NUXT_PUBLIC_API_ROOT=https://api.example.com

# MSAB / mediasoup signaling (must be wss:// in production)
NUXT_PUBLIC_AUDIO_SERVER_URL=wss://msab.example.com

# Laravel Reverb (Echo realtime)
NUXT_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
NUXT_PUBLIC_REVERB_HOST=reverb.example.com
NUXT_PUBLIC_REVERB_PORT=443
NUXT_PUBLIC_REVERB_SCHEME=https

# Web push (optional for native, kept for parity)
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry (optional)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Whole-app maintenance wall. Keep `false` for normal store/OTA builds. Setting it `true`
# bakes the wall into the bundle, so turning maintenance OFF again requires shipping a
# NEW bundle (OTA push + app restart) — there is no runtime toggle on native.
NUXT_PUBLIC_MAINTENANCE_MODE=true
