# Local
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_API_ROOT=http://localhost:8000
# Match the MSAB dev server (see ./dev-server.sh). Omit to use nuxt defaults; set wss:// if MSAB uses TLS.
NUXT_PUBLIC_AUDIO_SERVER_URL=ws://localhost:3030
# R2 fetches use same-origin /__r2 proxy in dev (vite) automatically via AssetDownloader — no env required.
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
# Sentry error tracking (DSN from Sentry project settings — do not commit real values)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: override release tag (Cloudflare Pages sets CF_PAGES_COMMIT_SHA automatically)
NUXT_PUBLIC_SENTRY_RELEASE=
