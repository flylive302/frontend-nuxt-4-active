# OTA publish-time secrets (capacitor-07). Copy to `.env.ota` and fill.
#   cp .env.ota.example .env.ota
#
# These are R2 WRITE credentials + upload target — used ONLY by `npm run cap:publish`,
# which auto-loads this file (`node --env-file-if-exists=.env.ota`). They are NOT baked
# into the app bundle (that's `.env.capacitor`, which holds only the PUBLIC read URL).
# `.env.ota` is gitignored — never commit real values.
#
# The var NAMES are AWS_* because R2 is S3-compatible and the tooling reads the standard
# S3 env names; the VALUES are your Cloudflare R2 token, not Amazon.

# R2 S3 endpoint — your account id is in the dashboard URL.
R2_ENDPOINT=https://f7006f3d39297a83ca86eca240b906d4.r2.cloudflarestorage.com
R2_BUCKET=flylive-ota

# Public read base (the custom domain you connect to the bucket).
OTA_PUBLIC_BASE_URL=https://ota.flyliveapp.com

# R2 Account API token (Object Read & Write, scoped to flylive-ota).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
